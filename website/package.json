{
  "name": "piora-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "vinext build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vinext",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "1.2.1",
