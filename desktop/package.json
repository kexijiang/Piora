{
  "name": "@piora/desktop",
  "productName": "Piora",
  "version": "0.2.4",
  "private": true,
  "description": "Secure Electron desktop shell for Piora",
  "author": {
    "name": "Piora contributors",
    "url": "https://github.com/kexijiang/piora"
  },
  "publisher": "Piora",
  "copyright": "Copyright © 2026 Piora contributors",
  "license": "MIT",
  "homepage": "https://github.com/kexijiang/piora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kexijiang/piora.git"
  },
  "main": "dist/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "pack": "electron-builder --config electron-builder.yml --dir --win --x64 --publish never",
    "dist": "electron-builder --config electron-builder.yml --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  }
}
