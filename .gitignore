# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/.verification/
/verification-output/
/.tmp-pty-probe-*/

# next.js
/.next/
/out/

# desktop build output (electron-builder + tsc)
/desktop/dist/
/desktop/release/
/desktop/node_modules/
/desktop/build/whisper/
/desktop/build/whisper-downloads/
/desktop/build/release-notes.md

# electron download cache
.electron-cache/

# workbuddy workspace data
.workbuddy/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
*.jsonl
*.pem
*.key
*.p12
*.pfx
/certificates/
/desktop/certificates/

# editor/OS temp files
*.tmp
*.temp
*~
*.swp
*.swo
*.bak
*.orig
*.rej
.nfs*


# Never publish copied Pi/Codex runtime state or locally imported companion data.
.pi/
.codex/
.piora-data/
/local-pets/
/node_modules.broken/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/public/vendor/vditor/
.factory
