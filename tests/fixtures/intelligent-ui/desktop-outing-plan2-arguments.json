            "derived": "grandTotal"
          },
          {
            "input": "people"
          }
        ]
      }
    ],
    "views": [
      {
        "id": "note",
        "kind": "text",
        "text": "计算规则：门票 30 元/人（固定），车费按总额 120 元（固定，不随人数变化），餐费 = 人数 × 每人餐费。保存按钮会在项目目录下新建 result.json（已存在同名文件时不会覆盖）。"
      },
      {
        "id": "grandTotal",
        "kind": "metric",
        "label": "总费用",
        "unit": "元",
        "value": {
          "derived": "grandTotal"
        }
      },
      {
        "id": "perPersonView",
