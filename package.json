{
  "name": "piora",
  "version": "0.5.5-beta.41",
  "private": true,
  "description": "Open-source Pi coding agent desktop application",
  "author": {
    "name": "Piora contributors",
    "url": "https://github.com/kexijiang/piora"
  },
  "publisher": "Piora",
  "copyright": "Copyright © 2026 Piora contributors",
  "license": "MIT",
  "homepage": "https://github.com/kexijiang/piora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kexijiang/piora.git"
  },
  "bugs": {
    "url": "https://github.com/kexijiang/piora/issues"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "electron",
    "nextjs",
    "windows",
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.12"
    },
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "postcss": "$postcss",
    "proxy-addr": "2.0.8",
    "nanoid": "3.3.18",
    "sharp@0.34.5": "0.35.5",
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "undici": "$undici",
    "xmldom": "npm:@xmldom/xmldom@0.9.12",
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.12"
    },
    "katex": "$katex",
    "axios": "1.20.0"
  },
  "workspaces": [
    "desktop"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "extensions",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "brand:prepare": "node scripts/prepare-branding.mjs",
    "predev": "node scripts/prepare-development.mjs",
    "predev:desktop": "node scripts/prepare-development.mjs",
    "predev:lan": "node scripts/prepare-development.mjs",
    "prebuild": "npm run brand:prepare && npm run build:harmony-worker",
    "prebuild:web": "npm run brand:prepare && npm run build:harmony-worker",
    "pretypecheck": "npm run brand:prepare",
    "brand:icons": "node scripts/build-brand-icon.mjs",
    "dev": "next dev -H 127.0.0.1 -p 30141 --turbopack",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:reset-cache": "node scripts/reset-development-cache.mjs",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141 --turbopack",
    "build": "next build --webpack",
    "build:web": "node scripts/build-branded-target.mjs web",
    "build:desktop": "npm run build --workspace @piora/desktop",
    "build:app": "npm run build:web && npm run build:desktop",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @piora/desktop",
    "pretest": "npm run build:harmony-worker && npm run build:desktop",
    "test": "node scripts/run-tests.mjs",
    "test:shell-resource": "node --test --test-concurrency=1 --test-name-pattern=\"clipboard copies on click|packaged Electron Shell opens|managed xterm handles|managed PTY preserves state|native PowerShell preserves\" lib/clipboard-click-browser.test.mjs lib/shell-packaging.test.mjs lib/shell-runtime.test.mjs lib/shell-surface-browser.test.mjs lib/native-terminal-browser.test.mjs",
    "test:team": "node --test lib/team-*.test.mjs lib/runtime-evidence.test.mjs components/CollapsibleUserContent.test.mjs",
    "test:team:acceptance": "node scripts/run-team-acceptance.mjs",
    "test:team:soak": "node scripts/run-team-soak.mjs",
    "build:harmony-worker": "tsc -p tsconfig.harmony-worker.json",
    "perf:check": "node scripts/check-performance-budgets.mjs",
    "pack:win": "npm run build:app && npm run pack --workspace @piora/desktop",
    "dist:win": "npm run build:app && npm run dist --workspace @piora/desktop",
    "dist:win:preview": "npm run build:app && npm run dist:preview --workspace @piora/desktop",
    "pack:linux": "npm run build:app && npm run pack:linux --workspace @piora/desktop",
    "dist:linux": "npm run build:app && npm run dist:linux --workspace @piora/desktop",
    "verify:package": "node scripts/verify-packaged-web.mjs",
    "verify:portable": "node scripts/verify-portable-artifact.mjs",
    "verify:updater": "node scripts/verify-windows-update-artifacts.mjs desktop/release",
    "verify:release": "node scripts/verify-release-metadata.mjs",
    "verify:hygiene": "node scripts/verify-release-hygiene.mjs",
    "smoke:portable": "node scripts/smoke-test-portable.mjs",
    "test:companion:packaged": "node scripts/test-packaged-companion.mjs",
    "verify:backgrounds": "node scripts/verify-background-assets.mjs",
    "backgrounds:overview": "node scripts/create-background-overview.mjs",
    "licenses:generate": "node scripts/generate-license-inventory.mjs",
    "audit:runtime": "node scripts/audit-runtime-dependencies.mjs",
    "licenses:check": "node scripts/generate-license-inventory.mjs --check",
    "licenses:package": "node scripts/package-license-bundle.mjs",
    "licenses:package:check": "node scripts/package-license-bundle.mjs --check",
    "postinstall": "node scripts/patch-bundled-dependencies.mjs && npm run brand:prepare",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "harmony:docs": "node scripts/generate-harmony-docs.mjs",
    "harmony:docs:check": "node scripts/generate-harmony-docs.mjs --check && node scripts/verify-harmony-docs.mjs",
    "harmony:fixture:prepare": "node scripts/prepare-harmony-fixture.mjs",
    "harmony:fixture:verify-hap": "node scripts/verify-harmony-fixture-hap.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@deveco/deveco-cli": "1.3.9",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lobehub/icons": "^6.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@types/ssh2": "^1.15.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "brace-expansion": "5.0.12",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "hypium-driver": "6.1.210",
    "iconv-lite": "^0.7.3",
    "json-bigint": "^1.0.0",
    "json5": "^2.2.3",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "mediabunny": "1.62.1",
    "mermaid": "^12.2.0",
    "next": "^16.4.2",
    "node-pty": "1.1.0",
    "opencc-js": "^1.4.2",
    "playwright-core": "^1.64.1",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rrule": "^2.8.1",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0",
    "tar": "7.5.22",
    "three": "^0.186.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "undici": "8.12.3",
    "unified": "^11.0.5",
    "vscode-jsonrpc": "^9.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.186.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "optionalDependencies": {
    "@microsoft/winappcli": "0.7.1"
  }
}
