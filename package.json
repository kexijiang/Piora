{
  "name": "pigui",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Pi coding agent desktop application",
  "author": {
    "name": "piGUI contributors",
    "url": "https://github.com/kexijiang/pi-gui"
  },
  "publisher": "piGUI",
  "copyright": "Copyright © 2026 piGUI contributors",
  "license": "MIT",
  "homepage": "https://github.com/kexijiang/pi-gui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kexijiang/pi-gui.git"
  },
  "bugs": {
    "url": "https://github.com/kexijiang/pi-gui/issues"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "electron",
    "nextjs",
    "windows"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "dompurify": "3.4.12",
    "js-yaml": "4.3.1",
    "postcss": "$postcss",
    "sharp@0.34.5": "0.35.3"
  },
  "workspaces": [
    "desktop"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "build:web": "next build --webpack && node scripts/stage-standalone.mjs",
    "build:desktop": "npm run build --workspace @pi-gui/desktop",
    "build:app": "npm run build:web && npm run build:desktop",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @pi-gui/desktop",
    "test": "node --test components/*.test.mjs hooks/*.test.mjs lib/*.test.mjs lib/i18n/*.test.mjs",
    "pack:win": "npm run build:app && npm run pack --workspace @pi-gui/desktop",
    "dist:win": "npm run build:app && npm run dist --workspace @pi-gui/desktop",
    "verify:package": "node scripts/verify-packaged-web.mjs",
    "verify:release": "node scripts/verify-release-metadata.mjs",
    "smoke:portable": "node scripts/smoke-test-portable.mjs",
    "verify:backgrounds": "node scripts/verify-background-assets.mjs",
    "backgrounds:overview": "node scripts/create-background-overview.mjs",
    "licenses:generate": "node scripts/generate-license-inventory.mjs",
    "licenses:check": "node scripts/generate-license-inventory.mjs --check",
    "licenses:package": "node scripts/package-license-bundle.mjs",
    "licenses:package:check": "node scripts/package-license-bundle.mjs --check",
    "postinstall": "node scripts/patch-bundled-dependencies.mjs",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@lobehub/icons": "^5.6.0",
    "brace-expansion": "5.0.9",
    "katex": "^0.18.1",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
